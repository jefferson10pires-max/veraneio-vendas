{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": [
    {
      "public": "public",
      "cleanUrls": true,
      "ignore": [
        "firebase.json",
        "**/.*"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            },
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' data: blob: https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://api.dooki.com.br https://wsrv.nl; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
            },
            {
              "key": "Strict-Transport-Security",
              "value": "max-age=31536000; includeSubDomains"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/painel",
          "destination": "/painel.html"
        },
        {
          "source": "/adm",
          "destination": "/adm.html"
        },
        {
          "source": "**",
          "destination": "/loja.html"
        }
      ],
      "site": "vitrine-de-semijoias"
    },
    {
      "site": "site-revendedoras-veraneio",
      "public": "redirecionar",
      "redirects": [
        {
          "source": "/:path*",
          "destination": "https://vitrine-de-semijoias.web.app/:path",
          "type": 302
        }
      ]
    }
  ]
}