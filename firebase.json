{
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json" },
  "storage": { "rules": "storage.rules" },
  "functions": [{ "source": "functions", "codebase": "lojas", "runtime": "nodejs20" }],
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "ignore": ["firebase.json", "**/.*"],
    "headers": [
      { "source": "/config.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ],
    "rewrites": [
      { "source": "/painel", "destination": "/painel.html" },
      { "source": "/adm", "destination": "/adm.html" },
      { "source": "**", "destination": "/loja.html" }
    ]
  }
}
