{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/painel",
        "destination": "/painel.html"
      },
      {
        "source": "/adm",
        "destination": "/adm.html"
      },
      {
        "source": "**",
        "destination": "/loja.html"
      }
    ]
  }
}