rules_version = '2';
// Imagens: logos e banners de cada loja, fotos dos produtos
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }
    function imagemOk() {
      return request.resource == null
        || (request.resource.size < 4 * 1024 * 1024 && request.resource.contentType.matches('image/.*'));
    }

    match /lojas/{uid}/{arquivo=**} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == uid || isAdmin()) && imagemOk();
    }

    match /produtos/{arquivo=**} {
      allow read: if true;
      allow write: if isAdmin() && imagemOk();
    }
  }
}
