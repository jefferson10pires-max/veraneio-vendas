{
 "hosting": {
  "site": "veraneiosemijoias",
  "public": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
   {
    "source": "**",
    "destination": "/q.html"
   }
  ],
  "headers": [
   {
    "source": "**/*.@(jpg|png)",
    "headers": [
     {
      "key": "Cache-Control",
      "value": "public, max-age=604800"
     }
    ]
   },
   {
    "source": "**/*.html",
    "headers": [
     {
      "key": "Cache-Control",
      "value": "no-cache"
     }
    ]
   }
  ]
 }
}