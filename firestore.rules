rules_version = '2';
// Plataforma de lojas Veraneio — regras do Firestore
//
// Coleções:
//   admins/{uid}            → quem é ADM (criado à mão no console)
//   produtos/{id}           → catálogo com PREÇO DE ATACADO (só usuários logados leem)
//   sistema/catalogo        → "versão" do catálogo; mudar dispara a republicação das lojas
//   precos/{uid}            → margem da revendedora (privado: dona + ADM)
//   catalogos/{uid}         → catálogo PÚBLICO da loja, já com o preço final (só o servidor escreve)
//   slugs/{slug}            → endereço único de cada loja (só o servidor escreve)
//   lojas/{uid}             → aparência e dados públicos da loja
//   lojas/{uid}/dias/{data} → acessos e visualizações por dia
//   lojas/{uid}/leads/{id}  → carrinhos e pedidos das clientes finais
service cloud.firestore {
  match /databases/{database}/documents {

    function signed() { return request.auth != null; }
    function isAdmin() { return signed() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isOwner(uid) { return signed() && request.auth.uid == uid; }

    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /produtos/{id} {
      allow read: if signed();
      allow write: if isAdmin();
    }

    match /sistema/{id} {
      allow read, write: if isAdmin();
    }

    match /precos/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    match /catalogos/{uid} {
      allow read: if true;
      allow write: if false;
    }

    match /slugs/{slug} {
      allow read: if true;
      allow write: if false;
    }

    match /lojas/{uid} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isOwner(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['slug', 'status', 'criadoEm']));

      // Acessos: a loja pública só consegue somar +1
      match /dias/{dia} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if request.resource.data.keys().hasOnly(['data', 'uid', 'visitas', 'views'])
          && request.resource.data.uid == uid
          && request.resource.data.data == dia
          && request.resource.data.get('visitas', 0) <= 1;
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visitas', 'views'])
          && request.resource.data.get('visitas', 0) <= resource.data.get('visitas', 0) + 1;
      }

      // Carrinhos: a cliente final cria e atualiza o próprio carrinho até finalizar
      match /leads/{id} {
        allow read, delete: if isOwner(uid) || isAdmin();
        allow create: if request.resource.data.keys().hasOnly(['nome', 'tel', 'itens', 'total', 'status', 'ts', 'uid'])
          && request.resource.data.status == 'abandonado'
          && request.resource.data.uid == uid
          && request.resource.data.nome is string && request.resource.data.nome.size() <= 100
          && request.resource.data.tel is string && request.resource.data.tel.size() <= 30
          && request.resource.data.itens is list && request.resource.data.itens.size() <= 80;
        allow update: if isOwner(uid) || isAdmin()
          || (resource.data.status == 'abandonado'
              && request.resource.data.status in ['abandonado', 'enviado']
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'tel', 'itens', 'total', 'status', 'ts'])
              && request.resource.data.itens.size() <= 80);
      }
    }

    // Consultas do ADM em todas as lojas de uma vez
    match /{path=**}/dias/{dia} { allow read: if isAdmin(); }
    match /{path=**}/leads/{id} { allow read: if isAdmin(); }
  }
}
