rules_version = '2';
// Plataforma de lojas — regras do Firestore
//
// Quem é quem:
//   ADM          → tem documento em admins/{uid} (criado à mão no console)
//   revendedora  → tem loja em lojas/{uid} (criada pelo ADM); o uid do login é o da loja
//   visitante    → qualquer pessoa na loja pública (sem login)
// Qualquer pessoa consegue criar uma conta pela API pública do Firebase; por isso "estar logada" NÃO basta:
// tudo o que é da revendedora exige que exista a loja dela.
//
// Coleções:
//   admins/{uid}            → quem é ADM
//   produtos/{id}           → catálogo com PREÇO DE ATACADO (ADM edita; revendedoras leem)
//   atacado/{parte}         → catálogo de atacado montado pelo ADM (revendedoras leem)
//   sistema/{id}            → configurações e resumo da Yampi (só ADM)
//   precos/{uid}            → margem, preços, pronta entrega… da revendedora (dona + ADM)
//   catalogos/{uid}/partes  → catálogo PÚBLICO da loja, já com o preço final
//   banners/{uid}           → banners da loja
//   contas/{uid}            → e-mail, responsável e cidade da revendedora (só ADM)
//   acessos/{uid}           → último acesso ao painel (a revendedora grava a hora; só o ADM lê)
//   slugs/{slug}            → endereço único de cada loja (só ADM cria)
//   lojas/{uid}             → aparência e dados públicos da loja
//   lojas/{uid}/dias/{data} → acessos e visualizações por dia
//   lojas/{uid}/leads/{id}  → carrinhos e pedidos das clientes finais
//   lojas/{uid}/proprios    → peças próprias da revendedora
//   lojas/{uid}/fotos       → fotos próprias (públicas)
service cloud.firestore {
  match /databases/{database}/documents {

    function signed() { return request.auth != null; }
    function isAdmin() { return signed() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isOwner(uid) { return signed() && request.auth.uid == uid; }
    // dona de uma loja que existe (não basta ter conta)
    function isLoja(uid) { return isOwner(uid) && exists(/databases/$(database)/documents/lojas/$(uid)); }
    function isRevendedora() { return signed() && exists(/databases/$(database)/documents/lojas/$(request.auth.uid)); }
    function dono(uid) { return isLoja(uid) || isAdmin(); }
    function isCor(v) { return v is string && v.matches('^#[0-9a-fA-F]{6}$'); }
    // foto guardada pela revendedora: imagem embutida (data:image/…) ou endereço https
    function isFoto(v) { return v is string && v.size() <= 300000 && v.matches('^(data:image/(jpeg|png|webp|gif);base64,[A-Za-z0-9+/=]+|https://[^\\s"<>]+)$'); }

    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /produtos/{id} {
      allow read: if isRevendedora() || isAdmin();
      allow write: if isAdmin();
    }

    match /atacado/{parte} {
      allow read: if isRevendedora() || isAdmin();
      allow write: if isAdmin();
    }

    match /sistema/{id} {
      allow read, write: if isAdmin();
    }

    // formato que o painel grava; qualquer outra coisa é recusada (um documento malformado travava a republicação de todas as lojas)
    function precosOk(d) {
      return d.keys().hasOnly(['margem', 'arred', 'over', 'fixo', 'pronta', 'ocultas', 'excluidas', 'fotos', 'nomes', 'modo', 'atualizadoEm'])
        && d.get('margem', 0) is number && d.get('margem', 0) >= 0 && d.get('margem', 0) <= 1000
        && d.get('arred', '') is string
        && d.get('over', {}) is map && d.get('fixo', {}) is map
        && d.get('fotos', {}) is map && d.get('nomes', {}) is map
        && d.get('pronta', []) is list && d.get('ocultas', []) is list
        && d.get('excluidas', []) is list
        && d.get('pronta', []).size() <= 5000 && d.get('ocultas', []).size() <= 5000 && d.get('excluidas', []).size() <= 5000
        && d.get('modo', 'todo') in ['todo', 'pronta'];
    }
    // Aviso da Veraneio no painel de todas as revendedoras (só o ADM escreve)
    function avisoOk(d) {
      return d.keys().hasOnly(['ativo', 'titulo', 'texto', 'img', 'link', 'botao', 'em'])
        && d.get('ativo', false) is bool
        && d.get('titulo', '') is string && d.get('titulo', '').size() <= 80
        && d.get('texto', '') is string && d.get('texto', '').size() <= 600
        && d.get('botao', '') is string && d.get('botao', '').size() <= 30
        && (d.get('img', null) == null || isFoto(d.get('img', null)))
        && (d.get('link', '') == '' || (d.get('link', '') is string && d.get('link', '').size() <= 500 && d.get('link', '').matches('^https://[^\\s"<>]+$')));
    }
    match /avisos/{id} {
      allow read: if isRevendedora() || isAdmin();
      allow write: if isAdmin() && id == 'geral' && avisoOk(request.resource.data);
      allow delete: if isAdmin();
    }
    match /precos/{uid} {
      allow read, delete: if dono(uid);
      allow create, update: if dono(uid) && precosOk(request.resource.data);
    }

    match /catalogos/{uid}/partes/{parte} {
      allow read: if true;
      allow write: if dono(uid) && parte.matches('^p([0-9]|[1-3][0-9])$');
    }

    match /banners/{uid} {
      allow read: if true;
      allow create, update: if dono(uid) && request.resource.data.keys().hasOnly(['itens', 'em'])
        && request.resource.data.itens is list && request.resource.data.itens.size() <= 4;
      allow delete: if dono(uid);
    }

    match /contas/{uid} {
      allow read, write: if isAdmin();
    }

    match /acessos/{uid} {
      allow read: if isAdmin();
      allow write: if isAdmin()
        || (isLoja(uid) && request.resource.data.keys().hasOnly(['em']) && request.resource.data.em == request.time);
    }

    match /slugs/{slug} {
      allow read: if true;
      allow create, delete: if isAdmin();
    }

    // campos que a revendedora pode mudar na própria loja; só o que ela mudou é conferido
    function lojaOk(d, k) {
      return k.hasOnly(['nome', 'cor', 'logo', 'frase', 'sobre', 'aviso', 'frete', 'freteRegra', 'parcelas', 'insta', 'whats', 'barra', 'rodape', 'modo'])
        && (!k.hasAny(['cor']) || isCor(d.cor))
        && (!k.hasAny(['nome']) || (d.nome is string && d.nome.size() <= 80))
        && (!k.hasAny(['logo']) || d.logo == null || isFoto(d.logo))
        && (!k.hasAny(['modo']) || d.modo in ['todo', 'pronta']);
    }
    match /lojas/{uid} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // a revendedora não muda endereço, situação (ativa/pausada) nem data de criação,
      // e não grava dados pessoais aqui (o documento é público)
      // A revendedora só mexe nos campos de aparência que o painel tem (lista fechada).
      allow update: if isAdmin()
        || (isLoja(uid)
            && lojaOk(request.resource.data, request.resource.data.diff(resource.data).affectedKeys()));

      // Acessos: a loja pública só consegue somar +1, no dia de hoje, numa loja que existe.
      // 'ultima' diz qual peça foi vista nesta gravação, para a regra conferir que ela subiu exatamente 1.
      match /dias/{dia} {
        function hojeOk() {
          let p = dia.split('-');
          let t = timestamp.date(int(p[0]), int(p[1]), int(p[2]));
          return request.time > t - duration.value(1, 'd') && request.time < t + duration.value(2, 'd');
        }
        function viewOk(novo, velho) {
          let nv = novo.get('views', {});
          let vv = velho.get('views', {});
          let mud = nv.diff(vv).affectedKeys();
          return nv is map && nv.size() <= 3000
            && (mud.size() == 0
              || (novo.get('ultima', '') is string && mud.hasOnly([novo.get('ultima', '')])
                  && nv[novo.ultima] == vv.get(novo.ultima, 0) + 1));
        }
        allow read: if dono(uid);
        allow create: if dia.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && hojeOk()
          && exists(/databases/$(database)/documents/lojas/$(uid))
          && request.resource.data.keys().hasOnly(['data', 'uid', 'visitas', 'views', 'ultima'])
          && request.resource.data.uid == uid
          && request.resource.data.data == dia
          && request.resource.data.get('visitas', 0) in [0, 1]
          && request.resource.data.get('ultima', '').size() <= 64
          && viewOk(request.resource.data, {});
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visitas', 'views', 'ultima'])
          && hojeOk()
          && request.resource.data.get('visitas', 0) is int
          && (request.resource.data.get('visitas', 0) == resource.data.get('visitas', 0)
            || request.resource.data.get('visitas', 0) == resource.data.get('visitas', 0) + 1)
          && request.resource.data.get('ultima', '').size() <= 64
          && viewOk(request.resource.data, resource.data);
      }

      // Peças próprias da revendedora (dados de origem; o que a cliente vê sai em catalogos/)
      match /proprios/{id} {
        allow read, write: if dono(uid);
      }

      // Fotos próprias (trocadas ou de peças próprias): a loja pública lê; só a dona e o ADM gravam
      match /fotos/{id} {
        allow read: if true;
        allow create, update: if dono(uid)
          && request.resource.data.keys().hasOnly(['fotos', 'v'])
          && request.resource.data.fotos is list
          && request.resource.data.fotos.size() >= 1 && request.resource.data.fotos.size() <= 3
          && isFoto(request.resource.data.fotos[0])
          && (request.resource.data.fotos.size() < 2 || isFoto(request.resource.data.fotos[1]))
          && (request.resource.data.fotos.size() < 3 || isFoto(request.resource.data.fotos[2]));
        allow delete: if dono(uid);
      }

      // Carrinhos: a cliente final (sem login) cria e atualiza o próprio carrinho até finalizar.
      // Id no formato gerado pelo Firebase, data = hora do servidor, campos com tipo e tamanho conferidos.
      match /leads/{id} {
        function leadOk(d) {
          return d.nome is string && d.nome.size() >= 1 && d.nome.size() <= 100
            && d.tel is string && d.tel.size() <= 30
            && d.itens is list && d.itens.size() <= 80
            && d.total is number && d.total >= 0 && d.total <= 1000000
            && d.ts == request.time;
        }
        allow read, delete: if dono(uid);
        allow create: if id.matches('^[A-Za-z0-9]{20}$')
          && get(/databases/$(database)/documents/lojas/$(uid)).data.get('status', 'ativa') == 'ativa'
          && request.resource.data.keys().hasOnly(['nome', 'tel', 'itens', 'total', 'status', 'ts', 'uid'])
          && request.resource.data.status == 'abandonado'
          && request.resource.data.uid == uid
          && leadOk(request.resource.data);
        allow update: if dono(uid)
          || (resource.data.status == 'abandonado'
              && request.resource.data.status in ['abandonado', 'enviado']
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'tel', 'itens', 'total', 'status', 'ts'])
              && leadOk(request.resource.data));
      }
    }

    // Consultas do ADM em todas as lojas de uma vez
    match /{path=**}/dias/{dia} { allow read: if isAdmin(); }
    match /{path=**}/leads/{id} { allow read: if isAdmin(); }
  }
}
